# Scans include/eval/*_eval.h and writes eval_registry.inc
# Convention: foo_eval.h defines FooEvaluator

file(GLOB EVAL_HEADERS CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/include/eval/*_eval.h")
list(SORT EVAL_HEADERS)

# Evaluators listed here are built but omitted from eval_registry() / bench round-robin.
set(EVAL_REGISTRY_EXCLUDE component)

set(INCLUDES "")
set(ENTRIES "")
foreach(HEADER ${EVAL_HEADERS})
    get_filename_component(BASENAME ${HEADER} NAME)
    string(REGEX REPLACE "_eval\\.h$" "" NAME ${BASENAME})

    if(NAME IN_LIST EVAL_REGISTRY_EXCLUDE)
        continue()
    endif()

    string(SUBSTRING ${NAME} 0 1 FIRST)
    string(TOUPPER ${FIRST} FIRST_UP)
    string(SUBSTRING ${NAME} 1 -1 REST)
    set(CLASS "${FIRST_UP}${REST}Evaluator")

    string(APPEND INCLUDES "#include \"eval/${BASENAME}\"\n")
    string(APPEND ENTRIES "        {\"${NAME}\", \"${NAME}\", [] { return std::make_unique<${CLASS}>(); }},\n")
endforeach()

set(OUT_FILE "${CMAKE_BINARY_DIR}/generated/eval_registry.inc")
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/generated")
file(WRITE "${OUT_FILE}"
"// Generated by CMake from include/eval/*_eval.h — do not edit.
${INCLUDES}
inline const std::vector<EvalEntry>& eval_registry()
{
    static const std::vector<EvalEntry> entries = {
${ENTRIES}    };
    return entries;
}
")
